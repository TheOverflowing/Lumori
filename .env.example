# Copy to .env and fill API keys locally. Never commit keys.
# Base URLs include any required API prefix; PATH is appended once.
# CA1 uses text, embeddings and optional reranking. Speech/image may stay blank.
TEXT_BASE_URL=https://api.deepseek.com
TEXT_API_KEY=
TEXT_MODEL=deepseek-flash
TEXT_PATH=/chat/completions
# Enables response_format={"type":"json_object"} for supported providers.
TEXT_JSON_MODE=true
TEXT_EXTRA_JSON={"thinking":{"type":"disabled"},"max_tokens":6000}
# Model identifiers are example configuration; validate availability with your provider.

EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_PATH=/embeddings
# The adapter requests encoding_format=float; do not override it here.
EMBEDDING_EXTRA_JSON={}

# R4 selected profile: dedicated reranking on the same OpenRouter gateway.
# Leave RERANK_API_KEY blank to explicitly reuse the embedding key on this origin.
RERANK_BASE_URL=https://openrouter.ai/api/v1
RERANK_API_KEY=
RERANK_USE_EMBEDDING_KEY=true
RERANK_MODEL=qwen/qwen3-reranker-8b
RERANK_PATH=/rerank
RERANK_EXTRA_JSON={}

SPEECH_BASE_URL=
SPEECH_API_KEY=
SPEECH_MODEL=
SPEECH_PATH=/audio/speech
SPEECH_VOICE=alloy
SPEECH_EXTRA_JSON={}

IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_PATH=/images/generations
# Must return data[0].b64_json (PNG/JPEG/WebP). URL-only responses are not yet supported.
IMAGE_EXTRA_JSON={}

# Per-account calls include embeddings, reranking, generation, repair and media. Not a currency budget.
MAX_DAILY_API_CALLS=100
# Active queued/running tasks per account; repeated idempotent requests do not count twice.
MAX_PENDING_JOBS_PER_ACCOUNT=8
# Optional automatic source discovery. Browser setting is OFF for each new account.
# hybrid combines the reviewed teaching-source catalog with bounded Wikipedia
# article search; curated uses the catalog alone.
# brave enables full web search; supply its own key, never reuse a model key.
EXPLORATION_ENABLED=true
EXPLORATION_SEARCH_PROVIDER=hybrid
EXPLORATION_SEARCH_API_KEY=
# auto uses bounded public DNS fallback only for proxy fake-IP (198.18.0.0/15)
# and its exact ::ffff:0:0:0/96 translated form; never connects to these addresses.
# system disables that fallback. Neither changes your system DNS settings.
EXPLORATION_DNS_MODE=auto
EXPLORATION_MAX_ROUNDS=2
EXPLORATION_MAX_DOCUMENTS=5
EXPLORATION_MAX_CANDIDATES=12
EXPLORATION_MAX_SEARCH_CALLS=8
EXPLORATION_MAX_MODEL_CALLS=10
EXPLORATION_MAX_SECONDS=180
EXPLORATION_MAX_SOURCE_PAGES=20
EXPLORATION_MAX_SOURCE_CHUNKS=100
EXPLORATION_MAX_BYTES=10485760
EXPLORATION_FETCH_TIMEOUT=20
# Quiz/assignment: one question at a time, blind solve, tools, review, bounded repair.
# legacy_v3 is only for reproducing the previous experiment baseline. Lessons are unchanged.
GENERATION_WORKFLOW=agent_v1
AGENT_MAX_CALLS=180
AGENT_MAX_REPAIRS=1
AGENT_CONTEXT_CHARS=48000
# Optional candidate; requires separately pinned .venv-harness (see docs/agent/harness).
AGENT_RUNTIME=native
# Optional supervisor baseline for requests without an explicit web choice.
# sequential_v1 retains the previous flow. supervisor_v1 requires deepseek_harness;
# supervisor_v2 also supports the native text adapter.
# supervisor_v2 adds flexible answers, typed requirements and item-by-item review.
AGENT_ORCHESTRATION=sequential_v1
# Number of question briefs in each supervisor planning request (1..10).
AGENT_PLAN_BATCH_SIZE=8
# New web opt-in runs at most this many question workers at once (1..40).
AGENT_MAX_PARALLEL_QUESTIONS=20
# Experimental Harness CPU short-answer specialization; leave none for general courses.
AGENT_QUESTION_SPEC=none
HARNESS_TIMEOUT=240
HARNESS_MAX_REQUESTS=6
# Includes reasoning tokens; allowed range 256..32768. Larger budgets increase potential cost.
HARNESS_MAX_OUTPUT_TOKENS=4096
# Research options: off/high and text/json_object. High needs matching TEXT_EXTRA_JSON thinking settings.
HARNESS_REASONING_EFFORT=off
HARNESS_RESPONSE_FORMAT=text
# Optional: one new solve/review (or v2 compose) for invalid schema fields, using the same limits.
# v2 review may instead repair invalid candidate evidence once; both repairs share one allowance.
HARNESS_SCHEMA_REPAIRS=0
# HARNESS_PYTHON=/absolute/path/.venv-harness/bin/python
# HARNESS_EXECUTABLE=/absolute/path/.venv-harness/bin/dsh

# Browser accounts: HttpOnly, SameSite=Lax sessions; localhost HTTP uses false.
# Set AUTH_COOKIE_SECURE=true when serving through HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=fyp_session
AUTH_SESSION_HOURS=168
# Persistent login and registration attempt window (seconds).
AUTH_THROTTLE_WINDOW_SECONDS=900
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=10

# Document parsing: native PDF text first, then bounded local OCR on sparse pages.
# Requires local Poppler and Tesseract with chi_sim+eng trained data.
DOCUMENT_OCR_ENGINE=tesseract
DOCUMENT_OCR_LANGUAGES=chi_sim+eng
DOCUMENT_OCR_MAX_PAGES=30
DOCUMENT_VISUAL_MAX_PAGES=30
DOCUMENT_PARSE_TIMEOUT=120
# Experimental alternative: rapidocr, installed separately in .venv-parsing.

# Selected on R4 dev and validated on its held-out set; see docs/rag/R4_RESULTS_20260912.md.
# The Settings class retains dense/raw defaults for older installations.
# Alternatives: bm25_v1, hybrid_rrf_v1, hybrid_mmr_v1, hybrid_dense_lexical_v1.
# All preserve cosine score. Metadata weighting requires hybrid_dense_lexical_v1.
RETRIEVAL_STRATEGY=hybrid_dense_lexical_v1
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_RRF_K=60
RETRIEVAL_MMR_LAMBDA=0.7
RETRIEVAL_METADATA_WEIGHT=0
RETRIEVAL_DOCUMENT_ENCODING=title_path_v1
RETRIEVAL_QUERY_ENCODING=cs_instruction_v1
RETRIEVAL_CONTEXT_TOKENS=1024
RETRIEVAL_EXPANSION=none

# Run scripts/prepare_rag_tokenizer.py to obtain the pinned public tokenizer first.
# Token budget counts source text only; character offsets remain original-source coordinates.
# Reindex a document to apply changed settings; replacement is atomic on success.
# legacy_char_v1 retains the original fixed-character baseline for experiments.
CHUNK_STRATEGY=recursive_token_v1
CHUNK_MAX_TOKENS=256
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=0

# Production PDF/photo pipeline. TXT/Markdown still use native UTF-8 parsing.
DOCUMENT_BACKEND=mineru
# Defaults point to this workspace's installed runtimes; override when deploying.
# MINERU_PYTHON=/absolute/path/.venv-mineru/bin/python
# MINERU_RUNTIME=/absolute/path/mineru-runtime
# DOCLING_PYTHON=/absolute/path/.venv-docling/bin/python
# DOCLING_MODELS=/absolute/path/docling-models
DOCUMENT_WORKER_TIMEOUT=600
DOCUMENT_MAX_FIGURES=24
# Optional dedicated vision provider. If BASE_URL is blank, TEXT endpoint is used.
# The configured model must support image_url messages. IMAGE_* is image generation.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_PATH=/chat/completions
VISION_EXTRA_JSON={}

# Deployment host and reverse-proxy settings
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
FORWARDED_ALLOW_IPS=127.0.0.1

# Optional post-acceptance observer. Never changes grading or repair decisions.
DIFFICULTY_SHADOW_MODE=off
# review_v2: blind analysis plus answer/source verification; legacy_v1: archived observer.
DIFFICULTY_SHADOW_PROTOCOL=review_v2
# Optional blind-analysis model on the same text provider. Empty uses TEXT_MODEL.
DIFFICULTY_SHADOW_ANALYST_MODEL=
# none: 2400 tokens; low/high/max: thinking enabled, 12288 tokens; validation reserves its input size.
DIFFICULTY_SHADOW_ANALYST_EFFORT=none
# Optional verification-stage model on the same configured text provider. Empty uses TEXT_MODEL.
DIFFICULTY_SHADOW_VERIFIER_MODEL=
# none: 2400 output tokens; low/high/max: thinking enabled, 12288 output tokens. Calls still share task limits.
DIFFICULTY_SHADOW_VERIFIER_EFFORT=none
DIFFICULTY_SHADOW_MAX_CALLS=2
DIFFICULTY_SHADOW_MAX_QUESTIONS=1
DIFFICULTY_SHADOW_TIMEOUT=30
DIFFICULTY_SHADOW_REPEAT_DISAGREEMENTS=false
