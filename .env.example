# Copy to .env and fill API keys locally. Never commit keys.
# Base URLs include any required API prefix; PATH is appended once.
# CA1 uses text, embeddings and optional reranking. Speech/image may stay blank.
TEXT_BASE_URL=https://api.deepseek.com
TEXT_API_KEY=
TEXT_MODEL=deepseek-flash
TEXT_PATH=/chat/completions
# Enables response_format={"type":"json_object"} for supported providers.
TEXT_JSON_MODE=true
TEXT_EXTRA_JSON={"thinking":{"type":"disabled"},"max_tokens":6000}
# Future model: deepseek-v4.1flash. Change TEXT_MODEL explicitly and validate before use.

EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen/qwen3-embedding-8b
EMBEDDING_PATH=/embeddings
# The adapter requests encoding_format=float; do not override it here.
EMBEDDING_EXTRA_JSON={}

# R4 selected profile: dedicated reranking on the same OpenRouter gateway.
# Leave RERANK_API_KEY blank to explicitly reuse the embedding key on this origin.
RERANK_BASE_URL=https://openrouter.ai/api/v1
RERANK_API_KEY=
RERANK_USE_EMBEDDING_KEY=true
RERANK_MODEL=qwen/qwen3-reranker-8b
RERANK_PATH=/rerank
RERANK_EXTRA_JSON={}

SPEECH_BASE_URL=
SPEECH_API_KEY=
SPEECH_MODEL=
SPEECH_PATH=/audio/speech
SPEECH_VOICE=alloy
SPEECH_EXTRA_JSON={}

IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_PATH=/images/generations
# Must return data[0].b64_json (PNG/JPEG/WebP). URL-only responses are not yet supported.
IMAGE_EXTRA_JSON={}

# Per-account calls include embeddings, reranking, generation, repair and media. Not a currency budget.
MAX_DAILY_API_CALLS=100

# Browser accounts: HttpOnly, SameSite=Lax sessions; localhost HTTP uses false.
# Set AUTH_COOKIE_SECURE=true when serving through HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_NAME=fyp_session
AUTH_SESSION_HOURS=168
# Persistent login and registration attempt window (seconds).
AUTH_THROTTLE_WINDOW_SECONDS=900
AUTH_LOGIN_LIMIT=10
AUTH_REGISTER_LIMIT=10

# Document parsing: native PDF text first, then bounded local OCR on sparse pages.
# Requires local Poppler and Tesseract with chi_sim+eng trained data.
DOCUMENT_OCR_ENGINE=tesseract
DOCUMENT_OCR_LANGUAGES=chi_sim+eng
DOCUMENT_OCR_MAX_PAGES=30
DOCUMENT_VISUAL_MAX_PAGES=30
DOCUMENT_PARSE_TIMEOUT=120
# Experimental alternative: rapidocr, installed separately in .venv-parsing.

# Selected retrieval configuration. Research evidence lives in the separate lumori-fyp repository.
# The Settings class retains dense/raw defaults for older installations.
# Alternatives: bm25_v1, hybrid_rrf_v1, hybrid_mmr_v1, hybrid_dense_lexical_v1.
# All preserve cosine score. Metadata weighting requires hybrid_dense_lexical_v1.
RETRIEVAL_STRATEGY=hybrid_dense_lexical_v1
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_RRF_K=60
RETRIEVAL_MMR_LAMBDA=0.7
RETRIEVAL_METADATA_WEIGHT=0
RETRIEVAL_DOCUMENT_ENCODING=title_path_v1
RETRIEVAL_QUERY_ENCODING=cs_instruction_v1
RETRIEVAL_CONTEXT_TOKENS=1024
RETRIEVAL_EXPANSION=none

# Run scripts/prepare_rag_tokenizer.py to obtain the pinned public tokenizer first.
# Token budget counts source text only; character offsets remain original-source coordinates.
# Reindex a document to apply changed settings; replacement is atomic on success.
# legacy_char_v1 retains the original fixed-character baseline for experiments.
CHUNK_STRATEGY=recursive_token_v1
CHUNK_MAX_TOKENS=256
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=0

# Production PDF/photo pipeline. TXT/Markdown still use native UTF-8 parsing.
DOCUMENT_BACKEND=mineru
# Docker Compose supplies portable runtime paths. Native installs may override below.
# MINERU_PYTHON=/absolute/path/.venv-mineru/bin/python
# MINERU_RUNTIME=/absolute/path/mineru-runtime
# DOCLING_PYTHON=/absolute/path/.venv-docling/bin/python
# DOCLING_MODELS=/absolute/path/docling-models
DOCUMENT_WORKER_TIMEOUT=600
DOCUMENT_MAX_FIGURES=24
# Optional dedicated vision provider. If BASE_URL is blank, TEXT endpoint is used.
# The configured model must support image_url messages. IMAGE_* is image generation.
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_PATH=/chat/completions
VISION_EXTRA_JSON={}

# Comma-separated hostnames/IPs, without scheme or port. Add your domain for server access.
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Local HTTP by default. Use a reverse proxy with TLS before public deployment.
BIND_ADDRESS=127.0.0.1
PORT=8765
# Docker default includes both parsers. Set core only for TXT/Markdown usage.
LUMORI_BUILD_TARGET=full
